# Caldun environment configuration. Copy to .env.local and fill in.

# SEC EDGAR requires a descriptive User-Agent identifying the requester:
#   "<Company or App Name> <contact email>"
# See https://www.sec.gov/os/accessing-edgar-data
# When unset, Caldun runs in DEMONSTRATION mode using synthetic fixtures.
SEC_USER_AGENT=

# Max SEC requests per second (SEC fair-access limit is 10; keep headroom).
SEC_MAX_RPS=5
